---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Retrato Día de Muertos",
  description = "Crea y descarga tu retrato personalizado de Día de Muertos.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="description" content={description} />

    <title>{title}</title>
  </head>

  <body>
    <slot />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    margin: 0;
    padding: 0;
  }

  body {
    margin: 0;
    min-width: 320px;
    font-family: Arial, Helvetica, sans-serif;
    background: #110d0b;
  }

  button,
  input {
    font: inherit;
  }

  img,
  canvas {
    max-width: 100%;
  }
</style>
